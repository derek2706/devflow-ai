{
  "name": "devflow-ai",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter server build && pnpm --filter web build",
    "build:production": "pnpm db:generate && pnpm build",
    "build:vercel": "pnpm db:generate && pnpm --filter server build && node scripts/vercel-validate.mjs && node scripts/vercel-migrate.mjs && pnpm --filter web build",
    "start:production": "pnpm --filter web start",
    "test": "pnpm --filter server test && pnpm --filter web test && node --test scripts/*.test.mjs",
    "test:integration": "pnpm --filter server test:integration",
    "lint": "pnpm --filter web lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,cjs,mjs,css,json,md}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" README.md package.json compose.yaml pnpm-workspace.yaml",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,cjs,mjs,css,json,md}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" README.md package.json compose.yaml pnpm-workspace.yaml",
    "db:generate": "pnpm --filter server prisma:generate",
    "db:migrate": "pnpm --filter server exec prisma migrate deploy",
    "db:studio": "pnpm --filter server prisma:studio"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
