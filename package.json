{
  "name": "devflow-ai",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter server test",
    "test:integration": "pnpm --filter server test:integration",
    "lint": "pnpm --filter web lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,md}\" README.md package.json compose.yaml",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,md}\" README.md package.json compose.yaml",
    "db:generate": "pnpm --filter server prisma:generate",
    "db:migrate": "pnpm --filter server exec prisma migrate deploy",
    "db:studio": "pnpm --filter server prisma:studio"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
