NODE_ENV=development
PORT=5001
# Local frontend origin. On Vercel, omit this to use trusted deployment metadata,
# or set an explicit HTTPS custom domain (it takes precedence over the fallback).
WEB_URL=http://localhost:3000
# Optional additional trusted frontend origins, comma-separated. WEB_URL is always allowed.
# Example for a second local frontend: CORS_ORIGINS=http://localhost:2000
CORS_ORIGINS=
DATABASE_URL=postgresql://devflow:devflow_local_only@localhost:5433/devflow?schema=public
JWT_ACCESS_SECRET=replace-this-access-secret-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-this-refresh-secret-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
# Production always uses Secure cookies. Set true for HTTPS development.
# API_COOKIE_SECURE=true
# Enable only on Vercel. Also requires VERCEL=1 and NODE_ENV=production.
TRUST_VERCEL_PROXY=false
# Optional email delivery in production. Development and tests always use previews.
RESEND_API_KEY=
MAIL_FROM=DevFlow AI <noreply@example.com>

AI_MODE=local
OPENAI_API_KEY=
OPENAI_MODEL=
