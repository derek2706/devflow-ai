# Public browser URL prefix; same-origin in local development and on Vercel.
# Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=/api

# Development only: Next forwards /api to the independently running API watcher.
# Use a fixed HTTP(S) origin without credentials, a path, query, or fragment.
# Production ignores this variable and uses its native Next API function.
API_INTERNAL_URL=http://127.0.0.1:5001

# Set backend secrets and database configuration in Vercel's environment settings
# for the same project. Trusted production/preview origin resolution lives in
# the backend's environment configuration. See the root deployment guide.
